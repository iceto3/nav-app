# Editor defaults (v35). Legacy modules keep their compact layout; new modules follow these and the
# formatting rules in eslint.config.js (max 100 chars, one statement per line, 2-space indent).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{js,mjs,css,md}]
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
